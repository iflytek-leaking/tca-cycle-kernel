 static bool cm_cp_tune_algo(struct charger_manager *cm)
 {
 	struct cm_charge_pump_status *cp = &cm->desc->cp;
@@ -3098,6 +3182,7 @@ static bool cm_cp_tune_algo(struct charger_manager *cm)
 	int vbus_step = 0;
 	int ibus_step = 0;
 	int alarm_step = 0;
+	int sw_alarm = 60000;	/* ported from iFlytek: default when pps_with_dcdc off */
 	bool is_taper_done = false;
 
 	/* check taper done*/
@@ -3113,6 +3198,42 @@ static bool cm_cp_tune_algo(struct charger_manager *cm)
 		}
 	}
 
+	/* ported from iFlytek: pps_with_dcdc SW fast charge path (stock 0x7a34) */
+	if (cm->desc->pps_with_dcdc) {
+		if (cp->cp_target_ibat < cm->desc->switch_charge_max_ibat + 550000) {
+			if (cm->desc->sw_charge_status) {
+				dev_info(cm->dev, "%s, target ibat %d is too low for pps_with_dcdc, try disable dcdc\n",
+					 __func__, cp->cp_target_ibat);
+				cm_primary_charger_enable(cm, false);
+				cm->desc->sw_charge_current = 0;
+			}
+		} else {
+			if (!cm->desc->sw_charge_status) {
+				dev_info(cm->dev, "%s, target ibat %d when pps_with_dcdc, try enable dcdc\n",
+					 __func__, cp->cp_target_ibat);
+				cm_primary_charger_enable(cm, true);
+				cm->desc->sw_charge_current =
+					cm->desc->switch_charge_max_ibat / 2;
+			}
+		}
+
+		/*
+		 * ported from iFlytek: sw_alarm step. Stock used the unnamed
+		 * desc fields d156/d160/d164/d168 (mA/mV) compared as
+		 * (field * 1000); 原厂 stores the cp limits in uA/uV already.
+		 */
+		if (cp->cp_max_ibus < cp->ibus_uA || cp->cp_max_ibat < cp->ibat_uA)
+			sw_alarm = -40000;
+		else if (cp->cp_target_vbus < cp->vbus_uV)
+			sw_alarm = -40000;
+		else if (cp->cp_target_vbat < cp->vbat_uV)
+			sw_alarm = 60000;
+		else
+			sw_alarm = -40000;
+
+		cm_sw_fast_charge_algo(cm);
+	}
+
 	/* check battery voltage*/
 	vbat_step = cm_cp_vbat_step_algo(cm);
 
@@ -3145,8 +3266,9 @@ static bool cm_cp_tune_algo(struct charger_manager *cm)
 		alarm_step = CM_CP_VSTEP * 3;
 	}
 
-	cp->cp_target_vbus += min(min(min(min(vbat_step, ibat_step),
-					  vbus_step), ibus_step), alarm_step);
+	/* ported from iFlytek: stock aggregates sw_alarm as the 6th step */
+	cp->cp_target_vbus += min(min(min(min(min(vbat_step, ibat_step),
+					  vbus_step), ibus_step), alarm_step), sw_alarm);
 	cm_check_target_vbus(cm);
 
 	dev_info(cm->dev, "%s vbatt = %duV, ibatt = %duA, vbus = %duV, ibus = %duA, "
@@ -3329,6 +3451,27 @@ static void cm_cp_state_check_vbus(struct charger_manager *cm)
 		if (!cm_check_cp_charger_enabled(cm))
 			cm_cp_charger_enable(cm, true);
 
+		/*
+		 * ported from iFlytek: pps_with_dcdc SW current bookkeeping on
+		 * "volt tune ok" (stock 0x691c-0x6978). Guarded by pps_with_dcdc
+		 * so the non-iFlytek path is untouched.
+		 */
+		if (cm->desc->pps_with_dcdc) {
+			if (cp->cp_target_ibat <=
+			    cm->desc->switch_charge_max_ibat + 550000) {
+				cm->desc->sw_charge_current = 0;
+			} else {
+				dev_info(cm->dev, "target ibat %d when pps_with_dcdc, try enable dcdc\n",
+					 cp->cp_target_ibat);
+				cm_primary_charger_enable(cm, true);
+				cm->desc->sw_charge_current =
+					cm->desc->switch_charge_max_ibat;
+			}
+		}
+		dev_info(cm->dev, "volt tune ok, cp_target_ibat %d switch_charge_max_ibat %d sw_charge_status %d\n",
+			 cp->cp_target_ibat, cm->desc->switch_charge_max_ibat,
+			 cm->desc->sw_charge_status);
+
 		cm->desc->cm_check_fault = true;
 		return;
 	}
@@ -4163,6 +4306,11 @@ static bool cm_manager_adjust_current(struct charger_manager *cm, int jeita_stat
 	term_volt = desc->jeita_tab[jeita_status].term_volt;
 	target_cur = desc->jeita_tab[jeita_status].current_ua;
 
+	/* ported from iFlytek: record JEITA terminate voltage for the SW algo and
+	 * re-arm the OVP latch whenever the JEITA point is (re)evaluated. */
+	desc->jeita_vbat = term_volt;
+	desc->ovp_flag = false;
+
 	cm->desc->ir_comp.us = term_volt;
 	cm->desc->ir_comp.us_lower_limit = term_volt;
 
@@ -6717,6 +6865,14 @@ static struct charger_desc *of_cm_parse_desc(struct device *dev)
 	if (desc->psy_cp_stat && !desc->cp.cp_taper_current)
 		desc->cp.cp_taper_current = CM_CP_DEFAULT_TAPER_CURRENT;
 
+	/* ported from iFlytek: SW fast charge DT configuration (stock 0x8ed8) */
+	of_property_read_u32(np, "cm-pps-with-dcdc", &desc->pps_with_dcdc);
+	of_property_read_u32(np, "cm-pps-reach-drop", &desc->pps_reach_drop);
+	if (of_find_property(np, "cm-ifly-charge-control", NULL)) {
+		desc->ifly_charge_control = true;
+		dev_err(dev, "Set ifly_charge_control\n");
+	}
+
 	ret = cm_init_cap_remap_table(desc, dev);
 	if (ret)
 		dev_err(dev, "%s init cap remap table fail\n", __func__);
@@ -6771,6 +6927,10 @@ static int cm_get_bat_info(struct charger_manager *cm)
 	cm->desc->cur.wl_bpp_cur = info.cur.wl_bpp_cur;
 	cm->desc->cur.wl_epp_limit = info.cur.wl_epp_limit;
 	cm->desc->cur.wl_epp_cur = info.cur.wl_epp_cur;
+	/* ported from iFlytek: vendor SW current upper bound + charge term current */
+	cm->desc->cur.switch_charge_max_ibat = info.cur.switch_charge_max_ibat;
+	cm->desc->switch_charge_max_ibat = info.cur.switch_charge_max_ibat;
