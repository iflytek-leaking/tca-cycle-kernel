+/* ported from iFlytek: cm_sw_fast_charge_algo (stock .text 0x8018-0x82d4)
+ *
+ * Software fast-charge current closed loop for the pps_with_dcdc path.
+ * Constants are kept in the stock units: currents uA, voltages uV.
+ */
+static void cm_sw_fast_charge_algo(struct charger_manager *cm)
+{
+	struct charger_desc *desc = cm->desc;
+	int step_ocp, step_ovp, step, base, val;
+
+	if (!desc->sw_charge_status)
+		return;
+
+	if (desc->cp.ibat_uA > desc->cp.cp_target_ibat && desc->cp.ibus_uA <= 550000)
+		step_ocp = -1;
+	else
+		step_ocp = (desc->sw_charge_current < desc->switch_charge_max_ibat);
+
+	if (!desc->ovp_flag) {
+		if (desc->cp.vbat_uV >= desc->jeita_vbat) {
+			desc->ovp_flag = true;
+		} else {
+			step_ovp = (desc->sw_charge_current < desc->switch_charge_max_ibat);
+			goto have_steps;
+		}
+	}
+
+	dev_info(cm->dev, "%s, have switch ovp_flag, jeita_vbat %d\n",
+		 __func__, desc->jeita_vbat);
+
+	if (desc->cp.vbat_uV < desc->jeita_vbat || desc->cp.ibus_uA > 550000)
+		step_ovp = 0;
+	else
+		step_ovp = -1;
+
+have_steps:
+	/* ported from iFlytek: PPS reach-drop protection */
+	if (desc->pps_reach_drop != 0 &&
+	    desc->cp.ibus_uA <= 550000 &&
+	    desc->cp.vbat_uV >= desc->cp.cp_target_vbat - desc->pps_reach_drop - 20000)
+		step_ovp = -1;
+
+	base = min(desc->sw_charge_current, desc->switch_charge_max_ibat);
+	cm_vote_property(cm, desc->cp.cp_target_vbat + 200000,
+			 desc->psy_charger_stat,
+			 POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE_MAX);
+
+	step = min(step_ocp, step_ovp);
+	val = base + step * 100000;
+	dev_info(cm->dev, ">>>>>>charge_current: %d\n", val);
+
+	if (desc->sw_charge_current > 99999 &&
+	    val <= desc->switch_charge_max_ibat &&
+	    val >= desc->charge_term_current + 100000) {
+		desc->sw_charge_current = val;
+		if (step == 1)
+			cm_primary_charger_enable(cm, true);
+		cm->cm_charge_vote->vote(cm->cm_charge_vote, true,
+					 SPRD_VOTE_TYPE_IBAT,
+					 SPRD_VOTE_TYPE_IBAT_ID_IFLYTEK,
+					 SPRD_VOTE_CMD_MIN,
+					 desc->sw_charge_current, cm);
+		dev_info(cm->dev, ">>>>>>final sw_charge_current: %d\n",
+			 desc->sw_charge_current);
+	} else {
+		if (val < 100000)
+			cm_primary_charger_enable(cm, false);
+	}
+
+	dev_info(cm->dev,
+		 "\n>>>>>>>fast_charge_algo:step: %d\n"
+		 ">>>>>> step_otp_charge: %d\n"
+		 ">>>>>>>step_ocp_charge: %d\n"
+		 ">>>>>>>step_ovp_charge: %d\n"
+		 ">>>>>>>sw_charge_status: %d\n",
+		 step, 0, step_ocp, step_ovp, desc->sw_charge_status);
+}
