+
+	// del_timer_sync(&aw963xx->abnormal_irq_timer);
+
+	if (p_sar->priv_data != NULL) {
+		devm_kfree(p_sar->dev, p_sar->priv_data);
+	}
+
+	AWLOGE(p_sar->dev, "aw963xx_deinit ok!");
+}
