-		ret = -EMSGSIZE;
-		goto err;
-	}
-
-	memcpy(mb_put_data(txbuf, len), buf, len);
-
-	ret = tipc_chan_queue_msg(ca->chan, txbuf);
-	if (ret) {
-		pr_err("tipc_chan_queue_msg error :%d\n", ret);
-		goto err;
-	}
-
-	return len;
-
-err:
-	tipc_chan_put_txbuf(ca->chan, txbuf);
-
-	return ret;
-}
-
-int disp_ca_wait_response(void)
