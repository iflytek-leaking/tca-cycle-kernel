+		if (val != mapping) {
+			ret = btl_test_write_reg(FACTORY_REG_NOMAPPING, mapping);
+			if (ret < 0) {
+				BTL_TEST_ERROR("write 0x54 register fail");
+				return ret;
+			}
+			btl_sys_delay(FACTORY_TEST_DELAY);
+		}
+	}
+
+	return 0;
+}
