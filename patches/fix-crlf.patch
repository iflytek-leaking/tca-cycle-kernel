-
-        ret = fts_test_read_reg(addr, &val);
-        if ((ret >= 0) && (val == finish_val)) {
-            break;
-        } else
-            FTS_TEST_DBG("reg%x=%x,retry:%d", addr, val, times);
-    }
-
-    if (times >= FACTORY_TEST_RETRY) {
-        FTS_TEST_SAVE_ERR("scan timeout\n");
-        return -EIO;
-    }
-
-    return 0;
