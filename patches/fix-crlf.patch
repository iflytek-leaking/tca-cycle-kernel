-									 "%s, %d, %d, %d, %d, %d, ", \
-									 info->name, info->code, tx, rx,
-									 start_line, index);
-			start_line += tx;
-			csv_item_count++;
-		}
-	}
-
-	csv_length += snprintf(csv_buffer + csv_length, \
-						   CSV_BUFFER_LEN - csv_length, \
-						   "TestItem Num, %d, ", \
-						   csv_item_count);
-
-	if (line2_length > 0) {
-		csv_length += snprintf(csv_buffer + csv_length, \
-							   CSV_BUFFER_LEN - csv_length, \
-							   "%s", line2_buffer);
-	}
-
-	/* line 3 ~ 10	"\n" */
-	csv_length += snprintf(csv_buffer + csv_length, \
-						   CSV_BUFFER_LEN - csv_length, \
-						   "\n\n\n\n\n\n\n\n\n");
-
-	/* line 11 ~ data area */
-	for (i = 0; i < td->item_count; i++) {
