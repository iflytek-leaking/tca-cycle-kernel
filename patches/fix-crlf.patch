-		vcalb = desc->vcal_factor * desc->vscal_factor_vsense_in /
-			desc->iscal_factor * icalk / vcalk * vcalb_adj;
-
-		aw_dev_dbg(aw_dev->dev, "vcalk_dac_factor=%d, vscal_dac_factor=%d, icalk=%d, vcalk=%d",
