-			BTL_TEST_ERROR("test item data is null");
-			goto csv_save_err;
-		}
-
-		if (info->mc_sc) {
-			offset = 0;
-			for (j = 0; j < info->datalen;) {
-				for (k = 0; k < tdata->sc_node.node_num; k++) {
-					csv_length += snprintf(csv_buffer + csv_length, \
