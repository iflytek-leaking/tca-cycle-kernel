+                return -1;
+            return 0;
+        }
+        case ATSHA204A_CMD_GENDIG: {
+            if (0 != copy_from_user(&gendig, (u8 *)data, sizeof(gendig)))
+                return -1;
+            if (0 > atsha204a_gendig(sha204_sysdata->client, gendig.zone, gendig.slot, gendig.data, gendig.data_len))
