+static int aw881xx_append_channel_suffix(char *format, const char **change_name,
+			struct aw881xx *aw881xx)
+{
+	char buf[64] = { 0 };
+	uint8_t channel = aw881xx->channel;
+
+	snprintf(buf, 64, format, *change_name, channel);
+	*change_name = aw881xx_devm_kstrdup(aw881xx->dev, buf);
