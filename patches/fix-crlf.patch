+/******************************************************
+ *
+ * kcontrol
+ *
+ ******************************************************/
+static const DECLARE_TLV_DB_SCALE(digital_gain, 0, 50, 0);
+
+struct soc_mixer_control aw881xx_mixer = {
+	.reg = AW881XX_REG_HAGCCFG7,
+	.shift = AW881XX_VOL_REG_SHIFT,
