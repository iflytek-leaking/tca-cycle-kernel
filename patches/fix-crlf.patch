-
-	// Start calculation
-	p_temp = temporary;
-
-	// (1) 32 bytes inputKey
-	//     (Config[KeyID] or OTP[KeyID] or Data.slot[KeyID] or TransportKey[KeyID])
-	memcpy(p_temp, param->stored_value, SHA204_KEY_SIZE);
