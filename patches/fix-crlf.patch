+					GFP_KERNEL);
+	if (prof_info->prof_desc == NULL) {
+		aw_dev_err(aw_dev->dev, "prof_desc devm_kzalloc failed");
+		return -ENOMEM;
+	}
+
+	ret = aw_dev_parse_by_hdr_v_1_0_0_0(aw_dev, cfg_hdr);
+	if (ret < 0) {
+		aw_dev_err(aw_dev->dev, " failed");
+		return ret;
