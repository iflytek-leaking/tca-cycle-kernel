+static int aw881xx_codec_register(struct aw881xx *aw881xx)
+{
+	int ret = -EINVAL;
+	struct snd_soc_dai_driver *dai = NULL;
+
+	dai = devm_kzalloc(aw881xx->dev, sizeof(aw881xx_dai), GFP_KERNEL);
+	if (!dai)
+		return -ENOMEM;
+	memcpy(dai, aw881xx_dai, sizeof(aw881xx_dai));
+
+	if(aw881xx->rename_flag == AW_DEV_RENAME_ENABLE) {
+		ret = aw881xx_append_channel_suffix("%s-%d", &dai->name, aw881xx);
+		if (ret < 0)
+			return ret;
+		ret = aw881xx_append_channel_suffix("%s_%d",
+			&dai->playback.stream_name, aw881xx);
+		if (ret < 0)
+			return ret;
+		ret = aw881xx_append_channel_suffix("%s_%d",
+			&dai->capture.stream_name, aw881xx);
+		if (ret < 0)
+			return ret;
+		dev_set_name(aw881xx->dev, "%s_%d",
+			"aw881xx_smartpa", aw881xx->channel);
+		aw_dev_info(aw881xx->dev, "change dev_name:%s",
+			dev_name(aw881xx->dev));
+
+	}else {
+		ret = aw881xx_append_i2c_suffix("%s-%d-%x", &dai->name, aw881xx);
+		if (ret < 0)
+			return ret;
+		ret = aw881xx_append_i2c_suffix("%s_%d_%x",
+			&dai->playback.stream_name, aw881xx);
+		if (ret < 0)
+			return ret;
+		ret = aw881xx_append_i2c_suffix("%s_%d_%x",
+			&dai->capture.stream_name, aw881xx);
+		if (ret < 0)
+			return ret;
+	}
+
+	ret = aw_componet_codec_ops.aw_snd_soc_register_codec(aw881xx->dev,
+					&soc_codec_dev_aw881xx,
+					dai, ARRAY_SIZE(aw881xx_dai));
+	if (ret < 0) {
+		aw_dev_err(aw881xx->dev, "%s failed to register aw881xx: %d\n",
+				__func__, ret);
+		return ret;
+	}
+
+	if(aw881xx->rename_flag == AW_DEV_RENAME_ENABLE) {
+		dev_set_name(aw881xx->dev, "%d-00%x",
+			aw881xx->i2c->adapter->nr, aw881xx->i2c->addr);
+		aw_dev_info(aw881xx->dev, "reset dev_name:%s",
+			dev_name(aw881xx->dev));
+	}
+
+	return 0;
+}
