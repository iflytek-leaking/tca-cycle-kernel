+    for (i = 0; i < node_num; i++) {
+        if (0 == tdata->node_valid[i])
+            continue;
+
+        if ((data[i] < min[i]) || (data[i] > max[i])) {
+            FTS_TEST_SAVE_ERR("test fail,node(%4d,%4d)=%5d,range=(%5d,%5d)\n",
+                              i / rx + 1, i % rx + 1, data[i], min[i], max[i]);
+            result = false;
+        }
+    }
+
+    return result;
+}
