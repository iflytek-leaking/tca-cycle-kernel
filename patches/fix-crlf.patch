+/* Only V3 Pattern has mapping & no-mapping */
+int btl_mapping_switch(u8 mapping)
+{
+	int ret = 0;
+	u8 val = 0xFF;
+	struct btl_test *tdata = btl_ftest;
+
+	if (tdata->v3_pattern) {
+		ret = btl_test_read_reg(FACTORY_REG_NOMAPPING, &val);
+		if (ret < 0) {
+			BTL_TEST_ERROR("read 0x54 register fail");
+			return ret;
