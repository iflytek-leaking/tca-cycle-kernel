-			return ret;
-		vcalk = desc->cabl_base_value + desc->vcalk_value_factor * vcalk_val;
-		vcalb = desc->vcal_factor * desc->vscal_factor /
-			desc->iscal_factor * icalk / vcalk * vcalb_adj;
