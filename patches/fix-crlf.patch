-	struct power_supply *psy = NULL;
-
-	psy = power_supply_get_by_name(name);
-	if (psy) {
-		ret = power_supply_get_property(psy, data_type, &prop);
-		if (ret < 0) {
-			aw_dev_err(aw_dev->dev, "get data failed");
-			return -EINVAL;
