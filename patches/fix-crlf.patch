+			aw_dev_err(aw881xx->dev, "write re to nvram failed!");
+			return ret;
+		}
+	} else {
+		aw_dev_err(aw881xx->dev, "invalid cali re %d!", re);
+		return -EINVAL;
+	}
+
+	return 0;
+}
