+    u32 max_touch_num = ts_data->pdata->max_touch_number;
+    bool touch_event_coordinate = false;
+    struct input_dev *input_dev = ts_data->input_dev;
+	/* print tp point */
+	static char finger_down[FTS_MAX_POINTS_SUPPORT] = {0};
+	int log_x = 0;
+	int log_y = 0;
+
+#ifdef CONFIG_TOUCHSCREEN_POINT_REPORT_CHECK
+	cancel_delayed_work_sync(&tpd_cdev->point_report_check_work);
+	queue_delayed_work(tpd_cdev->tpd_report_wq, &tpd_cdev->point_report_check_work, msecs_to_jiffies(80));
+#endif
+    for (i = 0; i < ts_data->touch_event_num; i++) {
+        if (fts_input_report_key(ts_data, &events[i]) == 0) {
+            continue;
+        }
+		if (events[i].id >= max_touch_num)
+			continue;
+        touch_event_coordinate = true;
+        if (EVENT_DOWN(events[i].flag)) {
+#ifdef FTS_REPORT_BY_VENDOR_ALGO
+			if (tpd_cdev->vendor_tp_algo) {
+				tpd_touch_press(ts_data->input_dev, events[i].x, events[i].y, events[i].id,  events[i].area, events[i].p);
+			} else {
+            input_mt_slot(input_dev, events[i].id);
+            input_mt_report_slot_state(input_dev, MT_TOOL_FINGER, true);
+#if FTS_REPORT_PRESSURE_EN
+            input_report_abs(input_dev, ABS_MT_PRESSURE, events[i].p);
+#endif
+            input_report_abs(input_dev, ABS_MT_TOUCH_MAJOR, events[i].area);
+            input_report_abs(input_dev, ABS_MT_TOUCH_MINOR, events[i].minor);
+
+            input_report_abs(input_dev, ABS_MT_POSITION_X, events[i].x);
+            input_report_abs(input_dev, ABS_MT_POSITION_Y, events[i].y);
+			}
+#else
+            input_mt_slot(input_dev, events[i].id);
+            input_mt_report_slot_state(input_dev, MT_TOOL_FINGER, true);
+#if FTS_REPORT_PRESSURE_EN
+            input_report_abs(input_dev, ABS_MT_PRESSURE, events[i].p);
+#endif
+            input_report_abs(input_dev, ABS_MT_TOUCH_MAJOR, events[i].area);
+            input_report_abs(input_dev, ABS_MT_TOUCH_MINOR, events[i].minor);
+
+            input_report_abs(input_dev, ABS_MT_POSITION_X, events[i].x);
+            input_report_abs(input_dev, ABS_MT_POSITION_Y, events[i].y);
+
+#endif
+            touch_down_point_cur |= (1 << events[i].id);
+            touch_point_pre |= (1 << events[i].id);
+			/* print tp point */
+			if (!finger_down[events[i].id]) {
+				log_x = events[i].x;
+				log_y = events[i].y;
+				finger_down[events[i].id] = 1;
+				FTS_INFO("touch down id: %d, coord [%d:%d]", events[i].id, log_x, log_y);
+			}
+#if defined(CONFIG_TOUCHSCREEN_POINT_SIMULAT_UF)
+			uf_touch_report(true,events[i].x, events[i].y, events[i].id);
+#endif
+#if defined(CONFIG_TOUCHSCREEN_UFP_MAC) && defined(VENDOR_ONE_KEY)
+			one_key_report(true, events[i].x, events[i].y, events[i].id);
+#endif
+        } else {
+#if defined(CONFIG_TOUCHSCREEN_POINT_SIMULAT_UF)
+			uf_touch_report(false, -1, -1, events[i].id);
+#endif
+#if defined(CONFIG_TOUCHSCREEN_UFP_MAC) && defined(VENDOR_ONE_KEY)
+			one_key_report(false, -1, -1, events[i].id);
+#endif
+#ifdef FTS_REPORT_BY_VENDOR_ALGO
+			if (tpd_cdev->vendor_tp_algo) {
+				tpd_touch_release(ts_data->input_dev, events[i].id);
+			} else {
+				input_mt_slot(input_dev, events[i].id);
+				input_mt_report_slot_state(input_dev, MT_TOOL_FINGER, false);
+			}
+#else
+			input_mt_slot(input_dev, events[i].id);
+			input_mt_report_slot_state(input_dev, MT_TOOL_FINGER, false);
+#endif
+            touch_point_pre &= ~(1 << events[i].id);
+            /* print tp point */
+			if (finger_down[events[i].id] == 1) {
+				log_x = events[i].x;
+				log_y = events[i].y;
+				finger_down[events[i].id] = 0;
+				FTS_INFO("touch up id: %d, coord [%d:%d]", events[i].id, log_x, log_y);
+			}
+        }
+    }
+
+	if (unlikely(touch_point_pre ^ touch_down_point_cur)) {
+		for (i = 0; i < max_touch_num; i++)  {
+			if ((1 << i) & (touch_point_pre ^ touch_down_point_cur)) {
+#ifdef FTS_REPORT_BY_VENDOR_ALGO
+				if (tpd_cdev->vendor_tp_algo) {
+					tpd_touch_release(ts_data->input_dev, i);
+				} else {
+					input_mt_slot(input_dev, i);
+            		input_mt_report_slot_state(input_dev, MT_TOOL_FINGER, false);
+				}
+#else
+				input_mt_slot(input_dev, i);
+				input_mt_report_slot_state(input_dev, MT_TOOL_FINGER, false);
+#endif
+			}
+		}
+	}
+
+	if (touch_down_point_cur)
+		input_report_key(input_dev, BTN_TOUCH, 1);
+	else if (touch_event_coordinate || ts_data->touch_points) {
+		input_report_key(input_dev, BTN_TOUCH, 0);
+	}
+
+	ts_data->touch_points = touch_down_point_cur;
+	input_sync(input_dev);
+	return 0;
+}
+
+#else
+static int fts_input_report_a(struct fts_ts_data *ts_data, struct ts_event *events)
+{
+    int i = 0;
+    int touch_down_point_num_cur = 0;
+    bool touch_event_coordinate = false;
+    struct input_dev *input_dev = ts_data->input_dev;
+
+    for (i = 0; i < ts_data->touch_event_num; i++) {
+        if (fts_input_report_key(ts_data, &events[i]) == 0) {
+            continue;
+        }
+
+        touch_event_coordinate = true;
+        if (EVENT_DOWN(events[i].flag)) {
+            input_report_abs(input_dev, ABS_MT_TRACKING_ID, events[i].id);
+#if FTS_REPORT_PRESSURE_EN
+            input_report_abs(input_dev, ABS_MT_PRESSURE, events[i].p);
+#endif
+            input_report_abs(input_dev, ABS_MT_TOUCH_MAJOR, events[i].area);
+            input_report_abs(input_dev, ABS_MT_TOUCH_MINOR, events[i].minor);
+
+            input_report_abs(input_dev, ABS_MT_POSITION_X, events[i].x);
+            input_report_abs(input_dev, ABS_MT_POSITION_Y, events[i].y);
+            input_mt_sync(input_dev);
+
+            touch_down_point_num_cur++;
+            if ((ts_data->log_level >= 2) ||
+                ((1 == ts_data->log_level) && (FTS_TOUCH_DOWN == events[i].flag))) {
+                FTS_DEBUG("[A]P%d(%d, %d)[p:%d,tm:%d] DOWN!",
+                          events[i].id, events[i].x, events[i].y,
+                          events[i].p, events[i].area);
+            }
+        }
+    }
+
+    if (touch_down_point_num_cur)
+        input_report_key(input_dev, BTN_TOUCH, 1);
+    else if (touch_event_coordinate || ts_data->touch_points) {
+        if (ts_data->touch_points && (ts_data->log_level >= 1))
+            FTS_DEBUG("[A]Points All Up!");
+        input_report_key(input_dev, BTN_TOUCH, 0);
+        input_mt_sync(input_dev);
+    }
+
+    ts_data->touch_points = touch_down_point_num_cur;
+    input_sync(input_dev);
+    return 0;
+}
+#endif
