-	}
-
-	ret = aw883xx_dev_modify_dsp_cfg(aw_dev, desc->vcalb_dsp_reg,
-					(uint32_t)reg_val, desc->data_type);
-	if (ret < 0) {
-		aw_dev_err(aw_dev->dev, "modify dsp cfg failed");
