-		aw881xx->reset_gpio = -1;
-		aw881xx->irq_gpio = -1;
-	}
-
-
-	/*  vendor add*/
-	aw881xx_request_pinctrl(&i2c->dev);
-
-	if (gpio_is_valid(aw881xx->reset_gpio)) {
-		ret = aw881xx_append_suffix("%s_%x_%x", &aw881xx_rst, aw881xx);
-		if (ret < 0)
-			return ret;
-
-		ret = devm_gpio_request_one(&i2c->dev, aw881xx->reset_gpio,
