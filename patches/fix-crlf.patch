+			ret = PTR_ERR(cdfinger->fps_vio_off);
+			cfp_debug(ERR_LOG, "cdfinger->fps_vio_off fail!ret = %d\n", ret);
+			goto parse_err;
+		}
+	}
+	cfp_debug(DEBUG_LOG, "%s exit!\n", __func__);
+	return 0;
+parse_err:
+	cfp_debug(ERR_LOG, "%s cdfinger parse dts fail!\n", __func__);
+
+	return ret;
+}
