-						aw881xx_irq_name, aw881xx);
-		if (ret != 0) {
-			aw_dev_err(&i2c->dev,
-				"failed to request IRQ %d: %d\n",
-				gpio_to_irq(aw881xx->irq_gpio), ret);
-			goto err_irq;
-		}
-	} else {
-		aw_dev_info(&i2c->dev, "%s skipping IRQ registration\n",
