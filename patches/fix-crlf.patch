+static void *aw881xx_devm_kstrdup(struct device *dev, char *buf)
+{
+	char *str = NULL;
+
+	str = devm_kzalloc(dev, strlen(buf) + 1, GFP_KERNEL);
+	if (!str) {
+		aw_dev_err(dev, "%s:devm_kzalloc %s failed\n",
+			__func__, buf);
+		return str;
+	}
+	memcpy(str, buf, strlen(buf));
+	return str;
+}
