-static void aw_dev_fade_in(struct aw_device *aw_dev)
-{
-	int i = 0;
-	struct aw_volume_desc *desc = &aw_dev->volume_desc;
-	int fade_step = aw_dev->fade_step;
-	uint16_t fade_in_vol = desc->ctl_volume;
-	if (!aw_dev->fade_en)
-		return;
