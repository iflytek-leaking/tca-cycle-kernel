-
-	if (vcalb_adj < AW881XX_VCALB_ADJ_MIN) {
-		aw_dev_err(aw881xx->dev, "%s:vcalb_adj 0x%04x is less than the minimum 0x019a\n",
-					__func__, vcalb_adj);
