-	/* read value */
-	aw881xx_reg_read(aw881xx, AW881XX_REG_HAGCCFG6, &reg_value);
-
-	/*[15 : 8] volume*/
-	real_value = reg_value >> AW881XX_VOL_REG_SHIFT;
-
-	real_value = aw881xx_reg_val_to_db(real_value);
-	*value = real_value;
