-	ret = aw881xx_get_profile_data(aw881xx, aw881xx->set_prof, &set_prof_desc);
-	if (ret < 0)
-		return ret;
-
-	aw_dev_info(aw881xx->dev, "%s:start update %s\n", __func__, prof_name);
-
-	sec_desc = set_prof_desc->sec_desc;
