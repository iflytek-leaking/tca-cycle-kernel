+int fts_test_write_reg(u8 addr, u8 val)
+{
+    int ret;
+    u8 cmd[2] = {0};
+
+    cmd[0] = addr;
+    cmd[1] = val;
+    ret = fts_test_bus_write(cmd, 2);
+
