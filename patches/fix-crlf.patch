-	prot_pack_w[0] = ((uint16_t)PROT_SEND_ADDR & GET_BITS_15_8) >> OFFSET_BIT_8;
-	prot_pack_w[1] = (uint16_t)PROT_SEND_ADDR & GET_BITS_7_0;
