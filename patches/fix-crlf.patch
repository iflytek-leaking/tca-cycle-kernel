-static void aw881xx_bubble_sort(uint32_t *data, int data_size)
-{
-	int loop_num = data_size - 1;
-	uint32_t temp_store = 0;
-	int i;
-	int j;
-
-	if (data == NULL) {
-		aw_pr_err("data is NULL");
-		return;
-	}
-
-	for (i = 0; i < loop_num; i++) {
-		for (j = 0; j < loop_num - i; j++) {
-			if (data[j] > data[j + 1]) {
-				temp_store = data[j];
-				data[j] = data[j + 1];
-				data[j + 1] = temp_store;
-			}
-		}
-	}
-}
