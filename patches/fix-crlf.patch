-
-    ret = fts_flash_read_buf(addr, buf, len);
-    if (ret < 0) {
-        FTS_ERROR("read flash fail");
-        goto read_flash_err;
-    }
-
-read_flash_err:
-    /* reset to normal boot */
-    ret = fts_fwupg_reset_in_boot();
