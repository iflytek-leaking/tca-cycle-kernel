-	mutex_init(&aw881xx->i2c_lock);
-
-	/* aw881xx rst & int */
-	if (np) {
-		ret = aw881xx_parse_dt(&i2c->dev, aw881xx, np);
-		if (ret < 0) {
-			aw_dev_err(&i2c->dev, "%s:failed to parse device tree node\n",
-				__func__);
