-	if ((monitor_cfg->monitor_status == AW_MON_CFG_OK) &&
-		monitor_cfg->monitor_switch) {
-
-		if (!aw883xx_dev_get_hmute(aw_dev)) {
-			aw_monitor_work(aw_dev);
-			queue_delayed_work(aw883xx->work_queue,
-				&monitor->delay_work,
