+static void aw881xx_update_dsp_data_order(struct aw881xx *aw881xx,
+						uint8_t *data, uint32_t data_len)
+{
+	int i = 0;
+	uint8_t tmp_val = 0;
+
+	aw_dev_dbg(aw881xx->dev, "%s: enter\n", __func__);
+
+	for (i = 0; i < data_len; i += 2) {
+		tmp_val = data[i];
+		data[i] = data[i + 1];
+		data[i + 1] = tmp_val;
+	}
+}
