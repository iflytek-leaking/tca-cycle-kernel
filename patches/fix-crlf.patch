+
+	ret = aw881xx_get_iis_status(aw881xx);
+	if (ret < 0) {
+		len += snprintf((char *)(buf + len),
+				PAGE_SIZE - len,
+				"%s: aw881xx no iis signal\n",
+				__func__);
+		return len;
