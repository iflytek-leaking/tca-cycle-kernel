-		enhance->slp_copy.cabc_endv = 255;
-		DPU_REG_WR(ctx->base + REG_SLP_CFG10, (enhance->slp_copy.cabc_endv << 8) |
-			(enhance->slp_copy.cabc_startv << 0));
