-    packet_num = byte_num / BYTES_PER_TIME;
-    packet_remainder = byte_num % BYTES_PER_TIME;
-    if (packet_remainder)
-        packet_num++;
-    read_num = BYTES_PER_TIME;
-
-    FTS_TEST_INFO("cb packet:%d,remainder:%d", packet_num, packet_remainder);
