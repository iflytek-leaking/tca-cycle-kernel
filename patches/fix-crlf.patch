+	ssize_t len = 0;
+	uint32_t r0;
+
+	aw881xx_get_dsp_config(aw881xx);
+	if (aw881xx->dsp_cfg == AW881XX_DSP_BYPASS) {
+		len += snprintf((char *)(buf + len), PAGE_SIZE - len,
+				"%s: aw881xx dsp bypass\n", __func__);
+		return len;
