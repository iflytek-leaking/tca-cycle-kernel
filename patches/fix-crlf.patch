+static int aw881xx_load_cfg_by_hdr_v_1_0_0_0(struct aw881xx *aw881xx, struct aw881xx_container *aw_cfg)
+{
+	int ret = -EINVAL;
+	struct aw_prof_info *prof_info = &aw881xx->prof_info;
