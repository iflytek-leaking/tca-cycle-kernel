-	reg_val = (uint16_t) vcalb;
-	aw_dev_info(aw881xx->dev, "%s: icalk=%d, vcalk=%d, vcalb=%d, reg_val=0x%04x\n",
-			__func__, icalk, vcalk, vcalb, reg_val);
-
-	ret = aw881xx_dsp_write(aw881xx, AW881XX_DSP_REG_VCALB, reg_val);
