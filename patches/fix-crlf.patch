+{
+	int ret;
+
+	aw_dev_info(aw_dev->dev, "data_size:%d enter", data_len);
+
+	ret = aw883xx_dev_dsp_data_order(aw_dev, data, data_len);
+	if (ret < 0)
+		return ret;
