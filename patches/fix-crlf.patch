+	//aw963xx->abnormal_irq_timer.expires= jffies + msecs_to_jiffies(30000);
+	// aw963xx->abnormal_irq_timer.data = (unsigned long)(p_sar);
+
+
+	INIT_WORK(&aw963xx->abnormal_irq_work, aw963xx_abnormal_irq_work_call_func);
