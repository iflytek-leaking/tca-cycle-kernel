+			uid = state->sk->sk_uid.val;
+		}
+
+		iph = ip_hdr(skb);
+		if (iph == NULL) {
+			return NF_ACCEPT;
+		}
+
+		if (data_direct == DATA_DIRECT_SEND) {
+			local_addr = &iph->saddr;
+			remote_addr = &iph->daddr;
+		} else {
+			local_addr = &iph->daddr;
+			remote_addr = &iph->saddr;
+		}
+
