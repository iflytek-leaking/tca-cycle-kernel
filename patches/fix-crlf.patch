+static void aw881xx_shutdown(struct snd_pcm_substream *substream,
+				struct snd_soc_dai *dai)
+{
+	aw_snd_soc_codec_t *codec = aw_get_codec(dai);
+
+	aw_dev_info(codec->dev, "%s:enter\n", __func__);
+}
