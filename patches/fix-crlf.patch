-	AWLOGD(&i2c->dev, "probe success!");
-
-	return 0;
-err_chip_init:
-	aw_sar_sensor_free(p_sar);
-err_get_voltage:
-if (p_sar->dts_info.use_regulator_flag == true) {
-	aw_sar_power_deinit(p_sar);
