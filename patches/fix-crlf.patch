+static int aw881xx_request_pinctrl(struct device *dev)
+{
+	struct pinctrl *pinctrl;
+	struct pinctrl_state *gpio_state_init;
+
+	pinctrl = devm_pinctrl_get(dev);
+	if (IS_ERR(pinctrl)) {
+		return PTR_ERR(pinctrl);
+	}
+
+	gpio_state_init = pinctrl_lookup_state(pinctrl, "audio_gpio_init");
+	if (IS_ERR(gpio_state_init)) {
+		dev_err(dev, "Can't find pinctrl state\n");
+		return PTR_ERR(gpio_state_init);
+	}
+
+	pinctrl_select_state(pinctrl, gpio_state_init);
+
+	return 0;
+}
