+				(uint8_t *)cfg_hdr + cfg_dde->data_offset,
+				cfg_dde->data_size, scene_prof_desc);
+	case ACF_SEC_TYPE_DSP_FW:
+		return aw881xx_parse_raw_dsp_fw(aw881xx,
+				(uint8_t *)cfg_hdr + cfg_dde->data_offset,
+				cfg_dde->data_size, scene_prof_desc);
+	}
+
+	return 0;
+}
