- *         len   - length of read
- * Output: buf   - data read from flash
- * Return: return 0 if success, otherwise return error code
- ***********************************************************************/
-static int fts_flash_read(u32 addr, u8 *buf, u32 len)
-{
-    int ret = 0;
-
-    FTS_INFO("***********read flash***********");
