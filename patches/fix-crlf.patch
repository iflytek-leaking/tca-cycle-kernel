+int fts_ts_suspend(struct device *dev)
+{
+	int ret = 0;
+	struct fts_ts_data *ts_data = fts_data;
+	int status;
+
+    FTS_FUNC_ENTER();
+    if (ts_data->suspended) {
+        FTS_INFO("Already in suspend state");
+        return 0;
+    }
+
+    if (ts_data->fw_loading) {
+        FTS_INFO("fw upgrade in process, can't suspend");
+        return 0;
+    }
+
+
+    fts_esdcheck_suspend(ts_data);
+	status = (ts_data->vendorc.is_wakeup_gesture << 1) | ts_data->vendorc.is_single_tap;
+
+	if (status)
+		ts_data->gesture_support = ENABLE;
+	else
+		ts_data->gesture_support = DISABLE;
+
+    if (ts_data->gesture_support) {
+        fts_gesture_suspend(ts_data);
+    } else {
+        fts_irq_disable();
+
+        FTS_INFO("make TP enter into sleep mode");
+        ret = fts_write_reg(FTS_REG_POWER_MODE, FTS_REG_POWER_MODE_SLEEP);
+        if (ret < 0)
+            FTS_ERROR("set TP to sleep mode fail, ret=%d", ret);
+
+        if (!ts_data->ic_info.is_incell) {
+/*
+#if FTS_POWER_SOURCE_CUST_EN
+            ret = fts_power_source_suspend(ts_data);
+            if (ret < 0) {
+                FTS_ERROR("power enter suspend fail");
+            }
+#endif
+*/
+        }
+    }
+#ifdef CONFIG_TOUCHSCREEN_POINT_REPORT_CHECK
+	cancel_delayed_work_sync(&tpd_cdev->point_report_check_work);
+#endif
+    fts_release_all_finger();
+    ts_data->suspended = true;
+    if (ts_data->vendorc.is_palm_mode) {
+        fts_write_reg(0x9A, 0x01);
+    }
+    FTS_FUNC_EXIT();
+    return 0;
+}
+
+int fts_ts_resume(struct device *dev)
+{
+    struct fts_ts_data *ts_data = fts_data;
+
+    FTS_FUNC_ENTER();
+    if (!ts_data->suspended) {
+        FTS_DEBUG("Already in awake state");
+        return 0;
+    }
+#ifdef CONFIG_TOUCHSCREEN_UFP_MAC
+	if (ufp_tp_ops.aod_fp_down) {
+		FTS_INFO("tpd:aod finger down!");
+		ufp_tp_ops.wait_completion = true;
+		if (!wait_for_completion_timeout(&ufp_tp_ops.ufp_completion, msecs_to_jiffies(1000))) {
+			FTS_INFO("tpd:aod finger down timeout!");
+		}
+	}
+	ufp_tp_ops.wait_completion = false;
+#endif
+    ts_data->suspended = false;
+	/*fts_release_all_finger();*/
+
+#ifdef CONFIG_TOUCHSCREEN_UFP_MAC
+	ts_data->vendorc.is_single_tap = (ts_data->vendorc.is_single_aod || ts_data->vendorc.is_single_fp) ? 5 : 0;
+	ts_data->vendorc.is_wakeup_gesture = ts_data->vendorc.is_set_wakeup_in_suspend;
+	ts_data->vendorc.is_one_key = ts_data->vendorc.is_set_onekey_in_suspend;
+#else
+	ts_data->vendorc.is_wakeup_gesture = ts_data->vendorc.is_set_wakeup_in_suspend;
+#endif
+
+	FTS_INFO("core_data->vendorc.is_single_tap is %d", ts_data->vendorc.is_single_tap);
+	FTS_INFO("core_data->vendorc.is_single_fp is %d", ts_data->vendorc.is_single_fp);
+	FTS_INFO("core_data->vendorc.is_wakeup_gesture is %d", ts_data->vendorc.is_wakeup_gesture);
+	FTS_INFO("core_data->vendorc.is_one_key is %d", ts_data->vendorc.is_one_key);
+
+    if (!ts_data->ic_info.is_incell) {
+#if FTS_POWER_SOURCE_CUST_EN
+        fts_power_source_resume(ts_data);
+#endif
+#ifdef CONFIG_TOUCHSCREEN_UFP_MAC
+		if (ufp_tp_ops.aod_fp_down) {  /*(ts_data->vendorc.is_one_key)*/
+			FTS_INFO("enter resume aod_aremeet_down");
+		} else {
+			fts_reset_proc(200);
+		}
+#else
+		fts_reset_proc(200);
+#endif
+	}
+    fts_wait_tp_to_valid();
+    fts_ex_mode_recovery(ts_data);
+
+    fts_esdcheck_resume(ts_data);
+
+    if (ts_data->gesture_support) {
+        fts_gesture_resume(ts_data);
+    } else {
+        fts_irq_enable();
+    }
+#ifdef CONFIG_TOUCHSCREEN_UFP_MAC
+	fts_write_reg(FTS_REG_FOD_EN, FTS_REG_FOD_VALUE);
+	FTS_INFO("FOD wirte 0x2 success");
+#endif
+    FTS_FUNC_EXIT();
+    return 0;
+}
