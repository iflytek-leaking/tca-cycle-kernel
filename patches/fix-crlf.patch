-		((slp->fst_max_bright_th_step[1] & 0x7f) << 7) |
-		((slp->fst_max_bright_th_step[2] & 0x7f) << 0));
-	DPU_REG_WR(ctx->base + REG_SLP_CFG2, ((slp->fst_max_bright_th_step[3] & 0x7f) << 25) |
-		((slp->fst_max_bright_th_step[4] & 0x7f) << 18) |
-		((slp->hist_exb_no & 0x3) << 16) |
