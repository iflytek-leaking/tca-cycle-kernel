+static void aw_bin_conver(uint8_t *data, uint32_t len)
+{
+	uint32_t i = 0;
+
+	for (i = 0; i < len; i += WORD_LEN) {
+		aw_swap(&(data[i + 0]), &(data[i + 3]));
+		aw_swap(&(data[i + 1]), &(data[i + 2]));
+	}
+}
+#endif
