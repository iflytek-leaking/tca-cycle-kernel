-static void aw_parse_port_id_dt(struct aw881xx *aw881xx)
-{
-	int ret = -EINVAL;
-
-	ret = of_property_read_u32(aw881xx->dev->of_node, "aw-rx-port-id", &g_rx_port_id);
-	if (ret < 0) {
-		g_rx_port_id = AW_RX_PORT_ID;
