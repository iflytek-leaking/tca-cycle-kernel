+				struct snd_soc_dai *dai)
+{
+	aw_snd_soc_codec_t *codec = aw_get_codec(dai);
+	struct aw881xx *aw881xx =
+		aw_componet_codec_ops.aw_snd_soc_codec_get_drvdata(codec);
