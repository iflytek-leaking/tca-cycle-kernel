-static void aw881xx_stop(struct aw881xx *aw881xx)
-{
-	uint8_t reg_addr = AW881XX_REG_SYSCTRL;
-	uint16_t reg_data;
-	int int_st = 0;
-	int monitor_int_st = 0;
