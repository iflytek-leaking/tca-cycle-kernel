-
-	ret = aw883xx_monitor_parse_fw(&aw_dev->monitor_desc,
-			aw_monitor_cnt->data, aw_monitor_cnt->len);
-	if (ret < 0)
-		aw_dev_err(aw_dev->dev, "parse monitor firmware failed!");
-
-	devm_kfree(aw_dev->dev, aw_monitor_cnt);
