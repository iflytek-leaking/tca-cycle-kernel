-	int ret;
-
-	ret = of_property_read_u32(aw_dev->dev->of_node, "aw-rx-port-id", &g_rx_port_id);
-	if (ret < 0) {
-		g_rx_port_id = AW_RX_PORT_ID;
-		aw_dev_info(aw_dev->dev, "read aw-rx-port-id failed,use default");
