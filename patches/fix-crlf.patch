-                FTS_ERROR("power enter suspend fail");
-            }
-#endif
-        }
-    }
-#ifdef CONFIG_TOUCHSCREEN_POINT_REPORT_CHECK
-	cancel_delayed_work_sync(&tpd_cdev->point_report_check_work);
-#endif
-    fts_release_all_finger();
-    ts_data->suspended = true;
-    FTS_FUNC_EXIT();
-    return 0;
