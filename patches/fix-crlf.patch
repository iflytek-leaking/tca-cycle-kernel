-int aw883xx_dev_modify_dsp_cfg(struct aw_device *aw_dev,
-			unsigned int addr, uint32_t dsp_data, unsigned char data_type)
-{
-	uint32_t addr_offset = 0;
-	int len = 0;
-	uint8_t temp_data[4] = { 0 };
