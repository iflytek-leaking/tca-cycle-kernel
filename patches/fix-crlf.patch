-static int aw_dev_prof_parse_multi_bin(struct aw_device *aw_dev,
-		uint8_t *data, uint32_t data_len, struct aw_prof_desc *prof_desc)
-{
-	struct aw_bin *aw_bin = NULL;
-	int i;
-	int ret;
