+static int aw_cali_svc_get_devs_cali_val(struct aw881xx *aw881xx,
+						int type, uint32_t *data_buf, int num)
+{
+	int ret = -EINVAL;
+	int cnt = 0;
+	struct list_head *dev_list = NULL;
+	struct list_head *pos = NULL;
+	struct aw881xx *local_dev = NULL;
+
+	/*get dev list*/
