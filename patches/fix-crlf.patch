-    }
-
-    if ((ECC_CHECK_MODE_CRC16 == upg->func->fw_ecc_check_mode) ||
-        (upg->func->upgspec_version >= UPGRADE_SPEC_V_1_0)) {
-        ecc = (int)((u16)(val[0] << 8) + val[1]);
-    } else {
-        ecc = (int)val[0];
-    }
-
-    return ecc;
-}
