+int btl_test_read_reg(u8 addr, u8 *val)
+{
+	return btl_test_bus_read(&addr, 1, val, 1);
+}
+
+int btl_test_write_reg(u8 addr, u8 val)
+{
+	int ret;
+	u8 cmd[2] = {0};
+
+	cmd[0] = addr;
+	cmd[1] = val;
+	ret = btl_test_bus_write(cmd, 2);
+
+	return ret;
+}
