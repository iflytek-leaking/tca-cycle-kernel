+	ret = aw881xx_i2c_write(aw881xx, AW881XX_REG_DSPMDAT, dsp_data);
+	if (ret < 0) {
+		aw_dev_err(aw881xx->dev, "%s: i2c write error, ret=%d\n",
+				__func__, ret);
+		goto dsp_write_err;
+	}
+
+ dsp_write_err:
+	aw881xx_clear_dsp_sel_st(aw881xx);
+	mutex_unlock(&aw881xx->i2c_lock);
