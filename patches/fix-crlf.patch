-	switch (id) {
-	case ENHANCE_CFG_ID_ENABLE:
-		p = param;
-		enhance->enhance_en |= *p;
-		pr_info("enhance module enable backup: 0x%x\n", *p);
-		break;
-	case ENHANCE_CFG_ID_DISABLE:
-		p = param;
