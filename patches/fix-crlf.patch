-	prot_pack_w[3] = (uint16_t)AW_HEADER_VAL & GET_BITS_7_0;
-
-	//size
-	prot_pack_w[4] = ((uint16_t)(AW_PACK_FIXED_SIZE + length) & GET_BITS_15_8) >> OFFSET_BIT_8;
-	prot_pack_w[5] = (uint16_t)(AW_PACK_FIXED_SIZE + length) & GET_BITS_7_0;
