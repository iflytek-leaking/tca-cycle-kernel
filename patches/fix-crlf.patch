-
-		if (info->datalen > node_num) {
-			data_count = (info->datalen - 1 ) / node_num + 1;
-			tx = (node_num - 1 ) / rx + 1;
-		} else {
-			data_count = 1;
-			tx = ((info->datalen - 1) / rx) + 1;
-		}
-
-		for (j = 1; j <= data_count; j++) {
-			index = j;
