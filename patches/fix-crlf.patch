-static void dpu_dump(struct dpu_context *ctx)
-{
-	u32 *reg = (u32 *)ctx->base;
-	int i;
-
-	pr_info("      0          4          8          C\n");
-	for (i = 0; i < 256; i += 4) {
-		pr_info("%04x: 0x%08x 0x%08x 0x%08x 0x%08x\n",
-			i * 4, reg[i], reg[i + 1], reg[i + 2], reg[i + 3]);
-	}
-}
