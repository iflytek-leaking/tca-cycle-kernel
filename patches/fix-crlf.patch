+		case HIGEST_SENSI:
+			cts_info("cts tp is highest sensibility");
+			break;
+		default:
+			cts_err("Unsupport tp sensibility level");
+			break;
+	}
+
+	cts_info("%s:retval=%d, sensibility_level=%d", __func__, retval, enable);
