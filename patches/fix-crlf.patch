+static int fts_test_bus_read(
+    u8 *cmd, int cmdlen, u8 *data, int datalen)
+{
+    int ret = 0;
+
+    ret = fts_read(cmd, cmdlen, data, datalen);
+    if (ret < 0)
+        return ret;
+    else
+        return 0;
+}
