+	.release = aw_cali_misc_release,
+	.unlocked_ioctl = aw_cali_misc_unlocked_ioctl,
+#ifdef CONFIG_COMPAT
+	.compat_ioctl = aw_cali_misc_compat_ioctl,
+#endif
+};
