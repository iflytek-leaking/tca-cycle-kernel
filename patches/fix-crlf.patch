+		ret = aw_dev_parse_dev_default_type(aw_dev, prof_hdr, &all_prof_info);
+		if (ret < 0)
+			return ret;
+	}
+
+	ret = aw_dev_cfg_get_vaild_prof(aw_dev, all_prof_info);
+	if (ret < 0)
+			return ret;
+
+	aw_dev->prof_info.prof_name_list = profile_name;
+
+	return 0;
+}
