-	}
-
-	for (i = 0; i < table_info.table_num; i++) {
-		if (data_trace->sum_val >= table_info.aw_table[i].min_val) {
-			memcpy(&data_trace->aw_table, &table_info.aw_table[i],
-				sizeof(struct aw_table));
