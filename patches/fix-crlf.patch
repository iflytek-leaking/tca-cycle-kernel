+			(cfg_dde[i].type == AW_DEV_DEFAULT_TYPE_ID)) {
+			if (cfg_dde[i].data_type == ACF_SEC_TYPE_MONITOR) {
+				ret = aw881xx_monitor_parse_fw(&aw881xx->monitor,
