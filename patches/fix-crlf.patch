+static int __init vendor_fp_init(void)
+{
+	vendor_fp_log(INFO_LOG, "%s enter!\n", __func__);
+
+#ifdef CONFIG_PLATFORM_FINGERPRINT_CDFINGER
+	vendor_fp_log(INFO_LOG, "cdfinger_fp_init enter!\n");
+	cdfinger_fp_init();
+#endif
