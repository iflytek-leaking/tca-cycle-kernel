+
+	aw881xx_cali_deinit(&aw881xx->cali_desc);
+	aw881xx_monitor_deinit(&aw881xx->monitor);
+	aw881xx_device_deinit(aw881xx);
+	aw_componet_codec_ops.aw_snd_soc_unregister_codec(&i2c->dev);
+
+	mutex_lock(&g_aw881xx_lock);
+	g_aw881xx_dev_cnt--;
