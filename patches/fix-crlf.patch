+	memcpy(p_temp, &param->other_data[SHA204_OTHER_DATA_SIZE_4], SHA204_OTHER_DATA_SIZE_3);  // use OtherData[4:6] for (7)
+	p_temp += SHA204_OTHER_DATA_SIZE_3;
+
