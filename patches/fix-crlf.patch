+
+	ret = aw881xx_get_r0(aw881xx, &r0);
+	if (ret < 0) {
+		len += snprintf((char *)(buf + len),
+				PAGE_SIZE - len,
+				"%s: read r0 failed\n",
+				__func__);
+		return len;
+	}
+	len += snprintf((char *)(buf + len),
+		PAGE_SIZE - len,
+		"r0: %d\n", r0);
+
+	return len;
+}
