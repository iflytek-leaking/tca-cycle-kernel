-static bool dpu_check_raw_int(struct dpu_context *ctx, u32 mask)
-{
-	u32 reg_val;
-
-	reg_val = DPU_REG_RD(ctx->base + REG_DPU_INT_RAW);
-	if (reg_val & mask)
-		return true;
-
-	pr_err("dpu_int_raw:0x%x\n", reg_val);
-	return false;
-}
