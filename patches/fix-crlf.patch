+	} else {
+		aw881xx_reg_write_bits(aw881xx, AW881XX_REG_SYSCTRL,
+					AW881XX_BIT_SYSCTRL_AMPPD_MASK,
+					AW881XX_BIT_SYSCTRL_AMPPD_ACTIVE);
