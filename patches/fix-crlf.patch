+/*
+[7 : 4]: -6DB ; [3 : 0]: 0.5DB  real_value = value * 2 : 0.5db --> 1
+*/
+uint32_t aw881xx_reg_val_to_db(uint32_t value)
+{
+	return ((value >> 4) * AW881XX_VOL_6DB_STEP +
+			((value & 0x0f) % AW881XX_VOL_6DB_STEP));
+}
+
+/*[7 : 4]: -6DB ;
+ *[3 : 0]: -0.5DB reg_value = value / step << 4 + value % step ;
+ *step = 6 * 2
+ */
+static uint32_t aw881xx_db_val_to_reg(uint32_t value)
+{
+	return (((value / AW881XX_VOL_6DB_STEP) << 4) + (value % AW881XX_VOL_6DB_STEP));
+}
+
+static int aw881xx_set_hw_volume(struct aw881xx *aw881xx, uint32_t value)
+{
+	uint16_t reg_value = 0;
+	uint16_t volume = 0;
+	uint32_t real_value = 0;
+
+	volume = AW_GET_MIN_VALUE(value, AW_FADE_OUT_TARGET_VOL);
+	real_value = aw881xx_db_val_to_reg(volume);
+	/*cal real value*/
+	aw881xx_reg_read(aw881xx, AW881XX_REG_HAGCCFG6, &reg_value);
+
+	aw_dev_dbg(aw881xx->dev, "%s: value %d , 0x%x\n",
+			__func__, value, real_value);
+
+	/*[15 : 8] volume*/
+	real_value = (real_value << AW881XX_VOL_REG_SHIFT) | (reg_value & 0x00ff);
+
+	/*write value*/
+	aw881xx_reg_write(aw881xx, AW881XX_REG_HAGCCFG6, real_value);
+
+	return 0;
+}
+
+static int aw881xx_get_hw_volume(struct aw881xx *aw881xx, uint32_t *value)
+{
+	uint16_t reg_value = 0;
+	uint32_t real_value = 0;
+
+	/* read value */
+	aw881xx_reg_read(aw881xx, AW881XX_REG_HAGCCFG6, &reg_value);
+
+	/*[15 : 8] volume*/
+	real_value = reg_value >> AW881XX_VOL_REG_SHIFT;
+
+	real_value = aw881xx_reg_val_to_db(real_value);
+	*value = real_value;
+
+	return 0;
+}
+
+int aw881xx_dev_set_volume(struct aw881xx *aw881xx, uint32_t value)
+{
+	int ret = -EINVAL;
+	uint32_t hw_vol = 0;
+	struct aw_volume_desc *vol_desc = &aw881xx->volume_desc;
+
+	hw_vol = value + vol_desc->init_volume;
+
+	ret = aw881xx_set_hw_volume(aw881xx, hw_vol);
+	if (ret < 0) {
+		aw_dev_err(aw881xx->dev, "set volume failed");
+		return ret;
+	}
+
+	return 0;
+}
+
+int aw881xx_dev_get_volume(struct aw881xx *aw881xx, uint32_t *get_vol)
+{
+	int ret = -EINVAL;
+	uint32_t hw_vol = 0;
+	struct aw_volume_desc *vol_desc = &aw881xx->volume_desc;
+
+	ret = aw881xx_get_hw_volume(aw881xx, &hw_vol);
+	if (ret < 0) {
+		aw_dev_err(aw881xx->dev, "read volume failed");
+		return ret;
+	}
+
+	*get_vol = hw_vol - vol_desc->init_volume;
+
+	return 0;
+}
+
+static void aw881xx_fade_in(struct aw881xx *aw881xx)
+{
+	int i = 0;
+	struct aw_volume_desc *desc = &aw881xx->volume_desc;
+	int32_t fade_in_vol = desc->ctl_volume;
+
+	if (!aw881xx->fade_en)
+		return;
+
+	if (g_fade_step == 0 || g_fade_in_time == 0) {
+		aw881xx_dev_set_volume(aw881xx, fade_in_vol);
+		return;
+	}
+
+	/*volume up*/
+	for (i = AW_FADE_OUT_TARGET_VOL; i >= fade_in_vol; i -= g_fade_step) {
+		aw881xx_dev_set_volume(aw881xx, i);
+		usleep_range(g_fade_in_time, g_fade_in_time + 10);
+	}
+
+	if (i != desc->ctl_volume)
+		aw881xx_dev_set_volume(aw881xx, desc->ctl_volume);
+
+}
+
+static void aw881xx_fade_out(struct aw881xx *aw881xx)
+{
+	int i = 0;
+	unsigned start_volume = 0;
+	struct aw_volume_desc *desc = &aw881xx->volume_desc;
+
+	if (!aw881xx->fade_en)
+		return;
+
+	if (g_fade_step == 0 || g_fade_out_time == 0) {
+		aw881xx_dev_set_volume(aw881xx, AW_FADE_OUT_TARGET_VOL);
+		return;
+	}
+
+	i = start_volume;
+	for (i = desc->ctl_volume; i <= AW_FADE_OUT_TARGET_VOL; i += g_fade_step) {
+		aw881xx_dev_set_volume(aw881xx, i);
+		usleep_range(g_fade_out_time, g_fade_out_time + 10);
+	}
+	if (i != AW_FADE_OUT_TARGET_VOL) {
+		aw881xx_dev_set_volume(aw881xx, AW_FADE_OUT_TARGET_VOL);
+		usleep_range(g_fade_out_time, g_fade_out_time + 10);
+	}
+}
