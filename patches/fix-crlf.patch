+void print_buffer(int *buffer, int length, int line_num)
+{
+    int i = 0;
+    int j = 0;
+    int tmpline = 0;
+    char *tmpbuf = NULL;
+    int tmplen = 0;
+    int cnt = 0;
+    struct fts_test *tdata = fts_ftest;
+
+    if (tdata && tdata->ts_data && (tdata->ts_data->log_level < 3)) {
+        return;
+    }
+
+    if ((NULL == buffer) || (length <= 0)) {
+        FTS_TEST_DBG("buffer/length(%d) fail", length);
+        return;
+    }
+
+    tmpline = line_num ? line_num : length;
+    tmplen = tmpline * 6 + MAX_SHOW;
+    tmpbuf = kzalloc(tmplen, GFP_KERNEL);
+
+    for (i = 0; i < length; i = i + tmpline) {
+        cnt = 0;
+        for (j = 0; j < tmpline; j++) {
+            cnt += snprintf(tmpbuf + cnt, tmplen - cnt, "%d,", buffer[i + j]);
+            if ((cnt >= tmplen) || ((i + j + 1) >= length))
+                break;
+        }
+        FTS_TEST_DBG("%s", tmpbuf);
+    }
+
+    if (tmpbuf) {
+        kfree(tmpbuf);
+        tmpbuf = NULL;
+    }
+}
+
+void show_buffer(int *buffer, int length, int line_num)
+{
+    int i = 0;
+    int line_size = 0;
+    int cnt = 0;
+    char line_buf[MAX_SHOW] = { 0 };
+
+    if (buffer && length) {
+        line_size = line_num ? line_num : length;
+        do {
+            cnt += snprintf(line_buf + cnt, MAX_SHOW - cnt, "%d,", buffer[i++]);
+            if (((i % line_size) == 0) || (i == length) || (cnt >= MAX_SHOW)) {
+                FTS_TEST_DBG("%s", line_buf);
+                cnt = 0;
+                memset(line_buf, 0, MAX_SHOW);
+            }
+        } while (i < length);
+    }
+}
