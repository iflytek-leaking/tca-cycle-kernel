-				}
-
-				/*MC_SC, SCAP index will be 1~4*/
-				if ((info->code == CODE_M_SCAP_CB_TEST)
-					|| (info->code == CODE_M_SCAP_RAWDATA_TEST)) {
-					index = btl_test_get_item_count_scap_csv(j);
-				}
-			}
-
-			line2_length += snprintf(line2_buffer + line2_length, \
