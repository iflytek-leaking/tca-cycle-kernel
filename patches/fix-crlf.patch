+
+	return ret;
+}
+
+int aw881xx_reg_write_bits(struct aw881xx *aw881xx,
+			uint8_t reg_addr, uint16_t mask, uint16_t reg_data)
+{
+	int ret = -EINVAL;
+
+	mutex_lock(&aw881xx->i2c_lock);
