-static int fts_gpio_configure(struct fts_ts_data *data)
-{
-    int ret = 0;
-
-    FTS_FUNC_ENTER();
-    /* request irq gpio */
-    if (gpio_is_valid(data->pdata->irq_gpio)) {
-        ret = gpio_request(data->pdata->irq_gpio, "fts_irq_gpio");
-        if (ret) {
-            FTS_ERROR("[GPIO]irq gpio request failed");
-            goto err_irq_gpio_req;
