+
+	ret = btl_i2c_write_read(g_btl_ts->client, CTP_SLAVE_ADDR, cmd, cmdlen, data, datalen);
+	if (ret < 0)
+		return ret;
+	else
+		return 0;
+}
+
+int btl_test_bus_write(u8 *writebuf, int writelen)
+{
