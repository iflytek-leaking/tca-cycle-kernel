diff --git a/kernel/pkg_observer.c b/kernel/pkg_observer.c
index b632cd15..63f536b9 100644
--- a/kernel/pkg_observer.c
+++ b/kernel/pkg_observer.c
@@ -23,6 +23,7 @@ struct watch_dir {
 
 static struct fsnotify_group *g;
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 9, 0)
 static int ksu_handle_inode_event(struct fsnotify_mark *mark, u32 mask,
                   struct inode *inode, struct inode *dir,
                   const struct qstr *file_name, u32 cookie)
@@ -45,6 +46,32 @@ static int ksu_handle_inode_event(struct fsnotify_mark *mark, u32 mask,
 static const struct fsnotify_ops ksu_ops = {
     .handle_inode_event = ksu_handle_inode_event,
 };
+#else
+/* 5.4 fsnotify: single handle_event() with the old signature */
+static int ksu_handle_event(struct fsnotify_group *group, struct inode *inode,
+                  u32 mask, const void *data, int data_type,
+                  const struct qstr *file_name, u32 cookie,
+                  struct fsnotify_iter_info *iter_info)
+{
+    if (!file_name)
+        return 0;
+    if (mask & FS_ISDIR)
+        return 0;
+    if (file_name->len == 13 &&
+        !memcmp(file_name->name, "packages.list", 13)) {
+        pr_info("packages.list detected: %d\n", mask);
+        if (ksu_uid_scanner_enabled) {
+            ksu_request_userspace_scan();
+        }
+        track_throne(false);
+    }
+    return 0;
+}
+
+static const struct fsnotify_ops ksu_ops = {
+    .handle_event = ksu_handle_event,
+};
+#endif
 
 static int add_mark_on_inode(struct inode *inode, u32 mask,
                  struct fsnotify_mark **out)
diff --git a/kernel/selinux/rules.c b/kernel/selinux/rules.c
index cd7c4720..05ec8975 100644
--- a/kernel/selinux/rules.c
+++ b/kernel/selinux/rules.c
@@ -9,15 +9,22 @@
 #include "linux/lsm_audit.h" // IWYU pragma: keep
 #include "xfrm.h"
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 4, 0)
 #define SELINUX_POLICY_INSTEAD_SELINUX_SS
+#endif
 
 #define ALL NULL
 
 static struct policydb *get_policydb(void)
 {
     struct policydb *db;
+#ifdef SELINUX_POLICY_INSTEAD_SELINUX_SS
     struct selinux_policy *policy = selinux_state.policy;
     db = &policy->policydb;
+#else
+    struct selinux_ss *ss = selinux_state.ss;
+    db = &ss->policydb;
+#endif
     return db;
 }
 
