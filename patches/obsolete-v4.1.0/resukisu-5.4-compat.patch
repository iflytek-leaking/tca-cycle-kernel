diff --git a/kernel/Kbuild b/kernel/Kbuild
index caac3096..4f1c8370 100644
--- a/kernel/Kbuild
+++ b/kernel/Kbuild
@@ -96,6 +96,15 @@ else
   $(info -- $(REPO_NAME) version (Github): $(KSU_VERSION_FULL))
 endif
 
+# Fallback: ReSukiSU v4.1.0 tags don't match upstream SukiSU-Ultra's REPO_BRANCH,
+# so the online/local version probes can yield empty values. Pin them.
+ifeq ($(strip $(KSU_VERSION)),)
+KSU_VERSION := 41000
+endif
+ifeq ($(strip $(KSU_VERSION_FULL)),)
+KSU_VERSION_FULL := v4.1.0-ReSukiSU
+endif
+
 ccflags-y += -DKSU_VERSION=$(KSU_VERSION)
 ccflags-y += -DKSU_VERSION_FULL=\"$(KSU_VERSION_FULL)\"
 
@@ -156,3 +165,15 @@ endif
 
 ccflags-y += -Wno-strict-prototypes -Wno-int-conversion -Wno-gcc-compat -Wno-missing-prototypes
 ccflags-y += -Wno-declaration-after-statement -Wno-unused-function -Wno-unused-variable
+
+# --- 5.4 compatibility (TCA Cycle Kernel) ---
+# TWA_RESUME task_work notify enum only exists from 5.8; 5.4 uses a bool.
+ifeq ($(shell test $(VERSION) -eq 5 -a $(PATCHLEVEL) -lt 8; echo $$?),0)
+ccflags-y += -DTWA_RESUME=true
+ccflags-y += -include $(srctree)/include/linux/sched/task.h
+endif
+
+# 5.4 (Android ACK) has seccomp_filter_release() but not put_seccomp_filter().
+ccflags-y += -Dput_seccomp_filter=seccomp_filter_release
+# 5.8 renamed strncpy_from_unsafe_user() -> strncpy_from_user_nofault().
+ccflags-y += -Dstrncpy_from_user_nofault=strncpy_from_unsafe_user
